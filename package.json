{
	"name": "discord-bot-template",
	"version": "1.1.7",
	"description": "¡Un bot de Discord listo para usar!",
	"type": "module",
	"main": "./dist/index.js",
	"scripts": {
		"start": "node dist/index.js",
		"dev": "nodemon",
		"prod": "pm2 start dist/index.js --name bot",
		"lint": "eslint src --fix",
		"lint:check": "eslint src",
		"format": "prettier --write src",
		"format:check": "prettier --check \"src/**/*.ts\"",
		"build": "tsc",
		"build:watch": "tsc --watch",
		"deploy": "node dist/deploySlashCommands.js"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/PipsaDevs/discord-bot-template.git"
	},
	"keywords": [
		"discord",
		"bot"
	],
	"author": "PipsaDevs",
	"license": "ISC",
	"bugs": {
		"url": "https://github.com/PipsaDevs/discord-bot-example/issues"
	},
	"homepage": "https://github.com/PipsaDevs/discord-bot-example#readme",
	"overrides": {
		"minimatch": "^11.0.3"
	},
		"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "12.18.0",
			"onFail": "download"
		}
	},
	"packageManager": "pnpm@12.18.0",
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/node": "^26.6.6",
		"@typescript/native": "npm:typescript@^7.0.2",
		"eslint": "^10.14.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-prettier": "^5.5.7",
		"globals": "^17.14.0",
		"jiti": "^2.7.0",
		"nodemon": "^3.1.14",
		"prettier": "^3.10.0",
		"tsx": "^4.23.15",
		"typescript": "npm:@typescript/typescript6@^6.0.2",
		"typescript-eslint": "^8.72.2"
	},
	"dependencies": {
		"discord.js": "^14.28.1",
		"dotenv": "^18.0.10"
	}
}
